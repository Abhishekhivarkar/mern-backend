{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ES2020",

    "types": ["node"],

    "typeRoots": [
      "./node_modules/@types",
      "./src/common/types"
    ],

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true
  },

  "include": ["src/**/*", "test-db.js"]
}