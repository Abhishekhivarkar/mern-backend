{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "target": "ES2020",

    "types": ["node"],

    "typeRoots": [
      "./node_modules/@types",
      "./src/common/types"
    ],

    "strict": true,
    "esModuleInterop": true
  },

  "include": ["src/**/*"]
}